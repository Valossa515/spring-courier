{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "gauge",
      "name": "Gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "id": null,
  "uid": "spring-courier-metrics",
  "title": "Spring Courier — CQRS Metrics",
  "description": "Observability dashboard for the Spring Courier library (commands, queries, notifications, pipelines).",
  "tags": ["spring-courier", "cqrs", "micrometer"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "application",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(courier_send_total, application)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(courier_send_total{application=~\"$application\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "📬 Overview",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Request Rate (send/s)",
      "description": "Commands + Queries dispatched per second",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(courier_send_total{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "send/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 100, "color": "yellow" },
              { "value": 500, "color": "red" }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Notification Rate (publish/s)",
      "description": "Notifications published per second",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(courier_publish_total{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "publish/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 100, "color": "yellow" },
              { "value": 500, "color": "red" }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error Rate",
      "description": "Total request failures per second (handler errors + validation failures)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(courier_handler_errors_total{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval])) + sum(rate(courier_validation_failures_total{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "errors/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "yellow" },
              { "value": 10, "color": "red" }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Validation Failures",
      "description": "Validation pipeline failures per second",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(courier_validation_failures_total{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "failures/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "yellow" },
              { "value": 10, "color": "red" }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "row",
      "title": "⏱️ Latency — Commands & Queries",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Send Latency — p50 / p95 / p99",
      "description": "Percentile latencies for courier.send()",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by(le) (rate(courier_send_duration_seconds_bucket{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by(le) (rate(courier_send_duration_seconds_bucket{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by(le) (rate(courier_send_duration_seconds_bucket{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Send Latency by Request Type (p95)",
      "description": "p95 latency broken down by request type",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le, request_type) (rate(courier_send_duration_seconds_bucket{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{request_type}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Send Throughput by Category",
      "description": "Requests per second split by command / query / generic",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "sum by(request_category) (rate(courier_send_duration_seconds_count{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{request_category}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Send Success vs Error Rate",
      "description": "Success and error send rates",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "sum by(outcome) (rate(courier_send_total{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "success" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "type": "row",
      "title": "📢 Notifications",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Publish Latency — p50 / p95 / p99",
      "description": "Percentile latencies for courier.publish()",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by(le) (rate(courier_publish_duration_seconds_bucket{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by(le) (rate(courier_publish_duration_seconds_bucket{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by(le) (rate(courier_publish_duration_seconds_bucket{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Publish Async Latency — p50 / p95 / p99",
      "description": "Percentile latencies for courier.publishAsync()",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by(le) (rate(courier_publish_async_duration_seconds_bucket{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by(le) (rate(courier_publish_async_duration_seconds_bucket{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by(le) (rate(courier_publish_async_duration_seconds_bucket{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Notification Throughput by Type",
      "description": "Notifications per second by notification type",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 31 },
      "targets": [
        {
          "expr": "sum by(notification_type) (rate(courier_publish_total{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{notification_type}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } } }
    },
    {
      "type": "row",
      "title": "� Retry & Cache",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 56 }
    },
    {
      "id": 60,
      "type": "timeseries",
      "title": "Cache Hit / Miss Rate",
      "description": "Cache hits and misses per second",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 57 },
      "targets": [
        {
          "expr": "sum(rate(courier_cache_hits_total{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "hits/s"
        },
        {
          "expr": "sum(rate(courier_cache_misses_total{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "misses/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "hits/s" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "misses/s" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 61,
      "type": "gauge",
      "title": "Cache Hit Ratio",
      "description": "Percentage of cache hits vs total lookups",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 57 },
      "targets": [
        {
          "expr": "sum(rate(courier_cache_hits_total{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval])) / (sum(rate(courier_cache_hits_total{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval])) + sum(rate(courier_cache_misses_total{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "hit ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0.5, "color": "yellow" },
              { "value": 0.8, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "id": 62,
      "type": "timeseries",
      "title": "Retry Attempts & Exhaustions",
      "description": "Retry attempts and fully exhausted retries per second",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 65 },
      "targets": [
        {
          "expr": "sum(rate(courier_retry_attempts_total{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "retry attempts/s"
        },
        {
          "expr": "sum(rate(courier_retry_exhausted_total{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "exhausted/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "exhausted/s" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 63,
      "type": "stat",
      "title": "In-Flight Requests",
      "description": "Number of requests currently being processed",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 65 },
      "targets": [
        {
          "expr": "sum(courier_requests_in_flight_active_count{application=~\"$application\", instance=~\"$instance\"})",
          "legendFormat": "in-flight"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 50, "color": "yellow" },
              { "value": 200, "color": "red" }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "row",
      "title": "📦 Batch & Async",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 73 }
    },
    {
      "id": 70,
      "type": "timeseries",
      "title": "Send Async Latency — p50 / p95 / p99",
      "description": "Percentile latencies for courier.sendAsync()",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 74 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by(le) (rate(courier_send_async_duration_seconds_bucket{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by(le) (rate(courier_send_async_duration_seconds_bucket{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by(le) (rate(courier_send_async_duration_seconds_bucket{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 71,
      "type": "timeseries",
      "title": "Batch Send Latency — p50 / p95 / p99",
      "description": "Percentile latencies for batch sendAll()/sendAllAsync()",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 74 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by(le) (rate(courier_batch_send_duration_seconds_bucket{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by(le) (rate(courier_batch_send_duration_seconds_bucket{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by(le) (rate(courier_batch_send_duration_seconds_bucket{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 72,
      "type": "timeseries",
      "title": "Batch Size Distribution",
      "description": "Average batch size over time",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 82 },
      "targets": [
        {
          "expr": "rate(courier_batch_send_size_sum{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval]) / rate(courier_batch_send_size_count{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "avg batch size"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "type": "row",
      "title": "📦 Registry",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 90 }
    },
    {
      "id": 40,
      "type": "stat",
      "title": "Command/Query Handlers",
      "description": "Number of registered command/query handlers",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 57 },
      "targets": [
        {
          "expr": "courier_handlers_registered{application=~\"$application\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 41,
      "type": "stat",
      "title": "Notification Handlers",
      "description": "Number of registered notification handlers",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 57 },
      "targets": [
        {
          "expr": "courier_notification_handlers_registered{application=~\"$application\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 42,
      "type": "stat",
      "title": "Pipeline Behaviors",
      "description": "Number of registered pipeline behaviors",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 57 },
      "targets": [
        {
          "expr": "courier_pipeline_behaviors_registered{application=~\"$application\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "row",
      "title": "🔎 Top Requests",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 61 }
    },
    {
      "id": 50,
      "type": "table",
      "title": "Top 10 Slowest Requests (p99)",
      "description": "Request types with highest p99 latency",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 62 },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.99, sum by(le, request_type) (rate(courier_send_duration_seconds_bucket{application=~\"$application\", instance=~\"$instance\"}[$__rate_interval]))))",
          "legendFormat": "{{request_type}}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "renameByName": { "request_type": "Request Type", "Value": "p99 (s)" } } }
      ]
    },
    {
      "id": 51,
      "type": "table",
